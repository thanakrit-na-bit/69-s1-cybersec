##################################################
# 1. ADMIN OPERATIONS
##################################################

### 1.1 Register Admin
POST http://localhost:9091/admin/register-admin
Content-Type: application/json

{
  "firstname": "",
  "lastname": "",
  "email": "",
  "password": ""
}

### 1.2 Login Admin
# @name adminLogin
POST http://localhost:9091/admin/login
Content-Type: application/json

{
  "email": "",
  "password": "",
  "rememberMe": false
}

### 1.3 Forgot Password Admin
# sends a reset token to the email
POST http://localhost:9091/admin/forgot-password
Content-Type: application/json

{
  "email": ""
}

### 1.4 Reset Password Admin
# resetPasswordToken = the token received in the email from 1.3
POST http://localhost:9091/admin/reset-password
Content-Type: application/json

{
  "resetPasswordToken": "",
  "password": ""
}

### 1.5 Profile Admin
GET http://localhost:9091/admin/users/me
Authorization: Bearer {{adminLogin.response.body.data.token}}
##################################################
# 2. USER OPERATIONS
##################################################

### 2.1 Register User
POST http://localhost:9091/api/auth/local/register
Content-Type: application/json

{
  "username": "",
  "email": "",
  "password": ""
}

### 2.2 Login User
# @name userLogin
POST http://localhost:9091/api/auth/local
Content-Type: application/json

{
  "identifier": "",
  "password": ""
}

### 2.3 Forgot Password User
# sends a reset code to the email
POST http://localhost:9091/api/auth/forgot-password
Content-Type: application/json

{
  "email": ""
}

### 2.4 Reset Password User
# code = the token received in the email from 2.3
POST http://localhost:9091/api/auth/reset-password
Content-Type: application/json

{
  "code": "",
  "password": "",
  "passwordConfirmation": ""
}

### 2.5 Profile User
GET http://localhost:9091/api/users/me
Authorization: Bearer {{userLogin.response.body.jwt}}