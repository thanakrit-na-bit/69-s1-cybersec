Authorization: Bearer {{user_jwt_token}}

{
    "data": {
        "name": ""
    }
}

#### 3.2.4 Update Teacher
PUT {{base_url}}/api/teachers/1
Content-Type: application/json
Authorization: Bearer {{user_jwt_token}}

{
    "data": {
        "name": ""
    }
}

#### 3.2.5 Delete Teacher
DELETE {{base_url}}/api/teachers/1
Authorization: Bearer {{user_jwt_token}}

